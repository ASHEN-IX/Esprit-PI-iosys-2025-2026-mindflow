# Study Partner - Environment Configuration Template
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit the .env file to version control!

# ============================================================================
# DATABASE
# ============================================================================
MONGODB_URI=mongodb://mongodb:27017/study-partner
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/study-partner?retryWrites=true&w=majority

# ============================================================================
# AUTHENTICATION & JWT
# ============================================================================
# Generate strong random secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-string-here
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-characters-long-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Admin key for creating admin accounts during registration
ADMIN_KEY=your-admin-key-for-registration

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
# Gmail example: use App Password (not your real password)
# Outlook: use your account password
# SendGrid: use sendgrid username as SMTP_USER and API key as SMTP_PASS
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-not-real-password
SMTP_FROM=noreply@studypartner.com
SMTP_FROM_NAME=Study Partner

# ============================================================================
# STRIPE PAYMENT PROCESSING
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here
STRIPE_PRICING_TABLE_ID=your_pricing_table_id

# ============================================================================
# FRONTEND & CORS
# ============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://study-partner.com
ALLOWED_ORIGINS=http://localhost:5173,https://study-partner.com,https://www.study-partner.com

# Frontend URL for email links
FRONTEND_URL=http://localhost:5173

# ============================================================================
# REDIS CACHE
# ============================================================================
# Used for session management, rate limiting, and caching
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=optional-redis-password

# ============================================================================
# SERVICES CONFIGURATION
# ============================================================================
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_GATEWAY_PORT=3001

# Service URLs (for local Docker setup)
AUTH_SERVICE_URL=http://auth-service:3001
USER_PROFILE_SERVICE_URL=http://user-profile-service:3002
STUDY_SERVICE_URL=http://study-service:3003
AI_ORCHESTRATOR_SERVICE_URL=http://ai-orchestrator-service:3004
SIGNAL_PROCESSING_SERVICE_URL=http://signal-processing-service:3005
ANALYTICS_SERVICE_URL=http://analytics-service:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3007

# ============================================================================
# AI & ML SERVICES
# ============================================================================
# Python AI Service Configuration
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
HUGGINGFACE_API_TOKEN=your-huggingface-token-for-models

# OpenAI (if using OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# SECURITY
# ============================================================================
# Bcrypt cost factor (10-12 recommended, lower in dev for speed)
BCRYPT_ROUNDS=10

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000  # 15 minutes

# CORS and security
ALLOW_INSECURE_HTTP=false  # Set to true only in development

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Optional: Sentry for error tracking
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Optional: Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================================================
# FILE UPLOADS
# ============================================================================
# S3 or compatible storage (MinIO in development)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=study-partner-uploads
AWS_S3_ENDPOINT=http://minio:9000

# File upload limits (in bytes)
MAX_UPLOAD_SIZE=10485760  # 10MB

# ============================================================================
# SCHEDULING & CRON
# ============================================================================
# Enable scheduled jobs
SCHEDULER_ENABLED=true

# Cron expressions for tasks
DAILY_BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
CLEANUP_SCHEDULE=0 3 * * *       # 3 AM daily
ANALYTICS_SYNC_SCHEDULE=0 * * * * # Every hour

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_GAMIFICATION=true
ENABLE_AI_COACHING=true
ENABLE_FOCUS_DETECTION=true
ENABLE_MULTIPLAYER_SESSIONS=true
ENABLE_MARKETPLACE=false  # Coming soon

# Ranking/KP balancing
RANK_DAILY_KP_CAP=600

# Test/Development Flags
ALLOW_TEST_COUPONS=true
ALLOW_CUSTOM_THEMES=true

# ============================================================================
# DEBUGGING
# ============================================================================
# Enable verbose logging
DEBUG=app:*
VERBOSE_LOGGING=false
SHOW_SQL_QUERIES=false  # Log database queries

# Enable request/response logging
LOG_REQUESTS=true
LOG_RESPONSES=false

# ============================================================================
# SESSION & COOKIES
# ============================================================================
SESSION_SECRET=your-session-secret-min-32-characters-long
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ============================================================================
# HEALTH CHECK & SERVICE DISCOVERY
# ============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000  # 30 seconds
SERVICE_DISCOVERY_ENABLED=true

# ============================================================================
# MISCELLANEOUS
# ============================================================================
# Timezone for scheduled tasks
TZ=UTC

# App version (set during deployment)
APP_VERSION=1.0.0

# Support email
SUPPORT_EMAIL=support@studypartner.com

# Maintenance mode
MAINTENANCE_MODE=false
